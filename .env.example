# Postgres connection string (e.g. from Neon — use the pooled "-pooler" host).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Direct (non-pooled — no "-pooler" in the host) connection string, used only
# for `prisma migrate deploy`/`migrate dev`. The pooled endpoint above doesn't
# support the session-level advisory lock migrations take, so build systems
# (e.g. Netlify) need this set separately. Falls back to DATABASE_URL if unset.
DIRECT_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Numeric PIN required to enter /admin.
ADMIN_PIN="1234"

# Secret used to sign the admin session cookie. Generate with `openssl rand -hex 32`.
ADMIN_SESSION_SECRET="replace-with-a-long-random-value"
