# Postgres connection string (e.g. from Neon — use the pooled "-pooler" host).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Numeric PIN required to enter /admin.
ADMIN_PIN="1234"

# Secret used to sign the admin session cookie. Generate with `openssl rand -hex 32`.
ADMIN_SESSION_SECRET="replace-with-a-long-random-value"
